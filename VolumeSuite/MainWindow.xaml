<Window x:Class="VolumeSuite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:VolumeSuite.ViewModels"
        xmlns:conv="clr-namespace:VolumeSuite.Converters"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:cp="clr-namespace:ColorPicker;assembly=ColorPicker"


        
        Title="VolumeSuite"
        Width="880" Height="600"
        MinWidth="640" MinHeight="440"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- 全局文字阴影（默认空，由代码动态控制） -->
        <DropShadowEffect x:Key="GlobalTextShadow" Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0"/>

        

        <conv:PathToImageSourceConverter x:Key="PathToImageConverter"/>
        <!-- 全局强调色 -->
        <Color x:Key="AccentColor">#FF0000</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>

        <!-- 自定义标题栏按钮样式 -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#15FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#08FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭按钮特供样式（悬停变红） -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E81123"/>
                                <!-- Windows 标准的红 -->
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1707A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 自定义开关：蓝色轨道，圆头滑块 -->
        <!-- 自定义开关：使用动态强调色 -->
        <Style x:Key="AppToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="41"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <!-- 轨道 -->
                            <Border x:Name="Track"
                                    BorderBrush="#55FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Background="{DynamicResource AccentBrush}">
                                <Border.Opacity>0</Border.Opacity>
                                <!-- 默认关闭时透明 -->
                            </Border>
                            <!-- 滑块 -->
                            <Border x:Name="Thumb"
                                    Width="17" Height="17"
                                    CornerRadius="8.5"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    Margin="2.5,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- 开启时：轨道透明度变为 1，滑块右移 -->
                                            <DoubleAnimation Storyboard.TargetName="Track"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="19" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>

                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- 关闭时：轨道透明度变为 0，滑块左移 -->
                                            <DoubleAnimation Storyboard.TargetName="Track"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 自定义滑条：蓝色圆头滑块，蓝色进度 -->
        <!-- 自定义滑条：使用动态强调色 -->
        <Style x:Key="AppSlider" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- 底层轨道 -->
                            <Border Height="4"
                                    Background="#33FFFFFF"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <!-- 左侧已选部分 -->
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4"
                                                        Background="{DynamicResource AccentBrush}"
                                                        CornerRadius="2"
                                                        VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <!-- 右侧未选部分 -->
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <!-- 滑块 -->
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="16" Height="16">
                                                    <Ellipse Fill="{DynamicResource AccentBrush}"/>
                                                    <Ellipse Width="6" Height="6" Fill="White"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <conv:StringToLucideKindConverter x:Key="LucideKindConverter"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate DataType="{x:Type vm:BoolItemViewModel}">
            <Border Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" FontSize="13"
                               Foreground="#E0E0E0" VerticalAlignment="Center"/>
                    <ToggleButton Grid.Column="1"
                                  Style="{StaticResource AppToggleSwitch}"
                                  IsChecked="{Binding Value}"
                                  VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NumberItemViewModel}">
            <Border Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" FontSize="13"
                               Foreground="#E0E0E0" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1"
                            Style="{StaticResource AppSlider}"
                            Width="220"
                            Minimum="0"
                            Maximum="1"
                            IsMoveToPointEnabled="True"
                            Value="{Binding Position, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0"
                            PreviewMouseLeftButtonDown="NumberSlider_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="NumberSlider_PreviewMouseLeftButtonUp"/>
                    <TextBox Grid.Column="2"
                             Width="70"
                             Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                             TextAlignment="Right"
                             VerticalAlignment="Center"
                             Margin="10,0,0,0"
                             KeyDown="SettingTextBox_KeyDown"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TextItemViewModel}">
            <Border Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" FontSize="13"
                               Foreground="#E0E0E0" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Width="180"
                             Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                             VerticalAlignment="Center"
                             KeyDown="SettingTextBox_KeyDown"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ColorItemViewModel}">
            <Border Padding="14,12">
                <StackPanel>
                    <!-- 主行：标签 + 色块 + HEX + 展开按钮 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Label}" FontSize="13"
                                   Foreground="#E0E0E0" VerticalAlignment="Center"/>

                        <Border Grid.Column="1"
                                Background="#2A2A2A"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,4"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20"
                                        CornerRadius="4"
                                        Background="{Binding ValueAsBrush}"
                                        BorderBrush="#55FFFFFF"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding HexText}"
                                           FontSize="12"
                                           Foreground="#E0E0E0"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Grid.Column="2"
                                Content="展开"
                                Width="56" Height="30"
                                Click="ColorExpand_Click"/>
                    </Grid>

                    <!-- 展开区 -->
                    <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                            Background="#0AFFFFFF"
                            BorderBrush="#20FFFFFF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左：色相环 -->
                                <cp:SquarePicker Grid.Column="0" Width="200" Height="200"
                                                 SelectedColor="{Binding Value, Mode=TwoWay}"/>

                                <!-- 右：信息与吸管 -->
                                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top">

                                    <!-- 这一行是 HEX 标题 -->
                                    <TextBlock Text="HEX" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,4"/>

                                    <!-- 这一行控制输入框和按钮 -->
                                    <StackPanel Orientation="Horizontal">

                                        <!-- HEX 输入框放左边 -->
                                        <TextBox Width="120" Height="32"
                                                 Text="{Binding HexText, UpdateSourceTrigger=LostFocus}"
                                                 KeyDown="SettingTextBox_KeyDown"/>

                                        <!-- 吸管按钮放右边 -->
                                        <Button Content="🎯 吸取颜色" 
                                                Width="120" Height="32" Margin="37,0,0,0"
                                                Click="StartPickColor_Click"/>
                                    </StackPanel>

                                    <TextBlock Text="RGB" FontSize="12" Foreground="#A0A0A0" Margin="0,10,0,4"/>
                                    <TextBlock Text="{Binding RgbText}" FontSize="13" Foreground="#E0E0E0"/>

                                    <!-- 下方：吸色预览框及提示文字（把原来的 Margin 移到了外层） -->
                                    <StackPanel Visibility="{Binding IsPicking, Converter={StaticResource BoolToVis}}"
                                                Margin="140,-35,0,0">

                                        <!-- 极简大色块 -->
                                        <Border Background="{Binding PickPreviewBrush}" 
                                                CornerRadius="6"
                                                BorderBrush="#55FFFFFF" BorderThickness="1"
                                                Width="120" Height="60"/>

                                        <!-- 提示文字加回来了 -->
                                        <TextBlock Text="回车确认，右键/Esc取消" 
                                                   FontSize="11" Foreground="#A0A0A0" 
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>

                                </StackPanel>
                            </Grid>

                            <!-- 常用色板 -->
                            <TextBlock Text="常用" FontSize="12"
                                       Foreground="#A0A0A0" Margin="0,16,0,8"/>
                            <ItemsControl ItemsSource="{Binding CommonColors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="22" Height="22" CornerRadius="4"
                                                Background="{Binding Brush}"
                                                BorderBrush="#33FFFFFF" BorderThickness="1"
                                                Margin="0,0,6,0"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="CommonColor_Click"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 收藏夹 -->
                            <TextBlock Text="收藏（左键应用 / 右键清除）" FontSize="12"
                                       Foreground="#A0A0A0" Margin="0,16,0,8"/>
                            <ItemsControl ItemsSource="{Binding SavedColors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="22" Height="22" Margin="0,0,6,0"
                                              Background="Transparent"
                                              Cursor="Hand"
                                              MouseLeftButtonDown="SavedColor_Click"
                                              MouseRightButtonDown="SavedColor_RightClick">
                                            <Border CornerRadius="4"
                                                    Background="{Binding Brush}"
                                                    BorderBrush="#33FFFFFF" BorderThickness="1"
                                                    Visibility="{Binding IsFilled, Converter={StaticResource BoolToVis}}"/>
                                            <Border CornerRadius="4"
                                                    BorderBrush="#55FFFFFF" BorderThickness="1"
                                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:HotkeyItemViewModel}">
            <Border Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" FontSize="13"
                               Foreground="#E0E0E0" VerticalAlignment="Center"/>
                    <Border Grid.Column="1"
                            Background="#2A2A2A" CornerRadius="6"
                            Padding="12,6" MinWidth="160"
                            Cursor="Hand"
                            MouseLeftButtonDown="HotkeyBox_MouseDown">
                        <TextBlock Text="{Binding Display}" FontSize="12"
                                   Foreground="White" TextAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PathItemViewModel}">
            <Border Padding="14,12">
                <StackPanel>
                    <!-- 原有的路径和浏览按钮 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" FontSize="13"
                                   Foreground="#E0E0E0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Background="#2A2A2A" CornerRadius="6"
                                    Padding="10,6" MinWidth="280" MaxWidth="360"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Value}" FontSize="12"
                                           Foreground="#CCCCCC"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Button Content="浏览" Width="56" Height="30"
                                    Margin="8,0,0,0"
                                    Click="PathBrowse_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- ★ 缩略图列表（只在背景图片项显示） -->
                    <ItemsControl ItemsSource="{Binding Images}" Margin="0,12,0,0"
                                  Visibility="{Binding IsBackgroundImage, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 删掉了这里的 Background="#1AFFFFFF" -->
                                <Border Width="80" Height="50" CornerRadius="6" Margin="0,0,8,8"
                                        BorderBrush="#33FFFFFF" BorderThickness="1"
                                        Cursor="Hand" MouseLeftButtonDown="Thumbnail_Click" Tag="{Binding}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="0.6"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Converter={StaticResource PathToImageConverter}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border.Background>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DropdownItemViewModel}">
            <Border Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" FontSize="13"
                               Foreground="#E0E0E0" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              Width="220"
                              ItemsSource="{Binding Options}"
                              SelectedValue="{Binding CurrentValue}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <!-- ==================== 窗口最外层 ==================== -->
    <Grid>

        <!-- ========== 第一层：覆盖整窗的底 ========== -->
        <Border x:Name="OpaqueUnderlay" Background="#FE1A1A1A"/>
        <Image x:Name="BackgroundImage" Source="pack://application:,,,/background.png" Stretch="UniformToFill" Opacity="0.4" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Border x:Name="BackgroundShade" Background="#99000000"/>

        <!-- ========== 第二层：标题栏 + 内容 ========== -->
        <!-- ★ 就是这个 Grid 被误删了，导致所有东西叠在一起 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 第 0 行：标题栏 -->
                <RowDefinition Height="*"/>
                <!-- 第 1 行：内容区 -->
            </Grid.RowDefinitions>

            <!-- 顶部自定义标题栏 -->
            <Grid Grid.Row="0" x:Name="AppTitleBar" Height="32" Background="Transparent">
                <TextBlock Text="VolumeSuite" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#DDDDDD" FontSize="12" FontWeight="SemiBold"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimizeButton" Click="MinimizeButton_Click" Width="46" Height="32" Style="{StaticResource TitleBarButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M 0,0 L 10,0" Stroke="#DDDDDD" StrokeThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Click="MaximizeButton_Click" Width="46" Height="32" Style="{StaticResource TitleBarButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path x:Name="MaximizeIcon" Data="M 0,0 L 9,0 L 9,9 L 0,9 Z" Stroke="#DDDDDD" StrokeThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button x:Name="CloseButton" Click="CloseButton_Click" Width="46" Height="32" Style="{StaticResource CloseButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="#DDDDDD" StrokeThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 内容区（包含左右两列） -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============ 左侧侧栏 ============ -->
                <Border Grid.Column="0" Background="Transparent" BorderBrush="#33FFFFFF" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="10,12">
                            <ItemsControl x:Name="SidebarList" ItemsSource="{Binding Tools}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="SideItem" CornerRadius="6" Padding="10,10" Margin="0,0,0,2" Cursor="Hand" MouseLeftButtonUp="SideItem_Click" MouseRightButtonUp="SideItem_RightClick">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#15FFFFFF"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#25FFFFFF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Rectangle Grid.Column="0" Width="3" Height="16" Fill="{DynamicResource AccentBrush}" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Setter Property="Opacity" Value="0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.30"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.30"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>

                                                <iconPacks:PackIconLucide Grid.Column="1" Kind="{Binding Manifest.Glyph, Converter={StaticResource LucideKindConverter}}" Width="16" Height="16" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Manifest.DisplayName}" FontSize="13" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="1" Height="1" Background="#33FFFFFF" Margin="10,4,10,4"/>

                        <Border Grid.Row="2" x:Name="LauncherSettingsButton" CornerRadius="6" Padding="10,10" Margin="10,0,10,10" Cursor="Hand" MouseLeftButtonUp="LauncherSettings_Click" DataContext="{Binding LauncherSettings}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#15FFFFFF"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#25FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Rectangle Grid.Column="0" Width="3" Height="16" Fill="{DynamicResource AccentBrush}" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Opacity" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.30"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.30"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>

                                <iconPacks:PackIconLucide Grid.Column="1" Kind="Settings" Width="16" Height="16" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="2" Text="启动器设置" FontSize="13" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ============ 右侧详情 ============ -->
                <Grid Grid.Column="1">
                    <ScrollViewer Padding="36,28,36,36" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ToolContentPanel" DataContext="{Binding SelectedTool}">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="ToolContentTranslate" Y="0"/>
                            </StackPanel.RenderTransform>

                            <Grid Margin="0,0,0,28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Manifest.DisplayName}" 
                                               FontSize="24" 
                                               FontWeight="SemiBold" 
                                               Foreground="#FFFFFF"
                                               Effect="{DynamicResource GlobalTextShadow}"/>
                                    <TextBlock Text="{Binding Manifest.Description}" 
                                               FontSize="13" 
                                               Opacity="0.7" 
                                               Margin="0,6,0,0" 
                                               Foreground="#FFFFFF"/>
                                </StackPanel>

                                <Button Grid.Column="1" Width="44" Height="44" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Click="ToggleButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Opacity" Value="0.6"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="22">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLauncher}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid Width="18" Height="18">
                                        <Path x:Name="PlayIcon" Data="M 0,0 L 9.6,6.6 L 0,13.2 Z" Fill="White" Stroke="White" StrokeThickness="5" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,-1">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <StackPanel x:Name="PauseIcon" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Width="4.6" Height="16.8" CornerRadius="2.3" Background="White"/>
                                            <Border Width="4.6" Height="16.8" CornerRadius="2.3" Background="White" Margin="4.8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Sections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,24">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="4,0,0,10"/>
                                            <Border CornerRadius="12" Padding="4" RenderTransformOrigin="0.5,0.5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.25">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.25">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#44FFFFFF" Duration="0:0:0.25"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                                <Trigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.ExitActions>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#1AFFFFFF" Offset="0"/>
                                                        <GradientStop Color="#08FFFFFF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.BorderBrush>
                                                    <SolidColorBrush Color="#20FFFFFF"/>
                                                </Border.BorderBrush>
                                                <Border.BorderThickness>1</Border.BorderThickness>

                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <ContentControl Content="{Binding}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>